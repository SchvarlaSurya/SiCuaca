APP_NAME=SiCuaca
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Di server: APP_ENV=production, APP_DEBUG=false, APP_URL=https://domain-anda

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sicuaca
DB_USERNAME=sicuaca
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Firebase Cloud Messaging ---------------------------------------------
# Path ke kunci service account Firebase (JSON). Relatif terhadap folder
# sicuaca-backend, atau path absolut di server (disarankan di luar folder
# web, mis. /etc/sicuaca/service-account.json, izin 600).
# JANGAN di-commit; storage/app/firebase/ sudah di .gitignore.
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# --- Pengecekan gempa BMKG (nilai bawaan sudah cocok untuk produksi) -------
SICUACA_AUTOGEMPA_URL=https://data.bmkg.go.id/DataMKG/TEWS/autogempa.json
SICUACA_GEMPATERKINI_URL=https://data.bmkg.go.id/DataMKG/TEWS/gempaterkini.json
SICUACA_BMKG_TIMEOUT=15
SICUACA_BMKG_PERCOBAAN=3
SICUACA_BMKG_JEDA_MS=1000
SICUACA_FCM_PERCOBAAN=3
SICUACA_FCM_JEDA_MS=1000
# Gempa lebih tua dari ini (jam) hanya dicatat, tidak dikirim.
SICUACA_MAKS_UMUR_JAM=6
# /health membalas 503 bila pengecekan terakhir lebih lama dari ini (menit).
SICUACA_HEALTH_BATAS_MENIT=5
