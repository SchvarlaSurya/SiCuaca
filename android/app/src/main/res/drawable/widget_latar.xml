<?xml version="1.0" encoding="utf-8"?>
<!-- Latar widget: gradasi biru tua ke biru (sama dengan splash dan ikon),
     sudut membulat. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF2F7BDB"
        android:endColor="#FF0B2552" />
    <corners android:radius="22dp" />
</shape>
