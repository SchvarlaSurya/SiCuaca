<?xml version="1.0" encoding="utf-8"?>
<!-- Widget cuaca: gradasi biru SiCuaca, teks putih. Hanya tampilan yang
     didukung RemoteViews (LinearLayout, TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_akar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_latar"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_wilayah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_nama"
        android:textColor="#CFE0FA"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_isi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_ikon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_ikon_contoh"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/widget_suhu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="27°"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_kondisi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_kondisi_contoh"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CFE0FA"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_kosong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:text="@string/widget_kosong"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_sumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_sumber_kosong"
        android:textColor="#9FB8DC"
        android:textSize="10sp" />
</LinearLayout>
