<?xml version="1.0" encoding="utf-8"?>
<!-- Pembaruan berkala dilakukan WorkManager (PembaruWidgetWorker), bukan
     updatePeriodMillis, supaya tiap jam dan hanya saat ada jaringan. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_deskripsi"
    android:initialLayout="@layout/widget_cuaca"
    android:minHeight="110dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_cuaca"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
